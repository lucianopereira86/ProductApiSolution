{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Test Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ProductApi.Tests/bin/Debug/net10.0/ProductApi.Tests.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "VSTEST_CONNECTION_TIMEOUT": "1200"
            }
        }
    ]
}